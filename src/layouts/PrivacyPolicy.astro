---
import Base from './Base.astro';
import { profile } from '../data/profile';
import { langs, type Lang, type PrivacyPolicy } from '../data/privacy-policy';

interface Props {
  /** The app's policy in every language. */
  policies: Record<Lang, PrivacyPolicy>;
  /** Where the policy is in each language, for the language switch. */
  path: (lang: Lang) => string;
  /** When the policy text last changed, as YYYY-MM-DD. */
  updated: string;
  lang: Lang;
}

const { policies, path, updated, lang } = Astro.props;
const policy = policies[lang];
const year = new Date().getFullYear();
---

<Base title={policy.title} description={policy.description} lang={lang} noindex>
  <main class="policy wrap">
    <nav class="top">
      <a class="home" href="/">danieltoft.dk</a>
      <ul class="langs">
        {
          langs.map((l) => (
            <li>
              {l === lang ? (
                <span aria-current="page">{policies[l].name}</span>
              ) : (
                <a href={path(l)} hreflang={l} lang={l}>
                  {policies[l].name}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <header>
      <h1>{policy.title}</h1>
      <p class="updated">
        {policy.updated} <time datetime={updated}>{updated}</time>
      </p>
    </header>

    <p class="lead">{policy.lead}</p>
    <p class="intro">{policy.intro}</p>

    {
      policy.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.blocks.map((block) =>
            'p' in block ? (
              <p set:html={block.p} />
            ) : (
              <ul>
                {block.list.map((item) => (
                  <li>
                    {item.term && <strong>{item.term}:</strong>} {item.text}
                  </li>
                ))}
              </ul>
            ),
          )}
        </section>
      ))
    }
  </main>

  <footer class="colophon wrap">© {year} {profile.name}</footer>
</Base>

<style>
  .policy {
    padding-block: clamp(2rem, 5vw, 3.5rem) 0;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }

  .home {
    color: var(--ink);
    font-weight: 600;
    text-decoration-color: transparent;
  }

  .home:hover {
    text-decoration-color: var(--ink);
  }

  .langs {
    display: flex;
    gap: var(--space-4);
    font-size: var(--step--1);
  }

  .langs [aria-current] {
    color: var(--ink);
    font-weight: 600;
  }

  header,
  .lead,
  .intro,
  section {
    max-width: 40rem;
  }

  header {
    margin-top: clamp(2.5rem, 7vw, 4.5rem);
  }

  h1 {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.25rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .updated {
    margin-top: var(--space-4);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .lead {
    margin-top: var(--space-6);
    color: var(--ink);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .intro {
    margin-top: var(--space-4);
  }

  section {
    margin-top: var(--space-6);
  }

  h2 {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 2rem;
    letter-spacing: -0.02em;
  }

  section p,
  section ul {
    margin-top: var(--space-2);
  }

  section li {
    padding-block: var(--space-2);
    border-top: 1px solid var(--sage-soft);
  }

  section li:last-child {
    border-bottom: 1px solid var(--sage-soft);
  }

  strong {
    color: var(--ink);
    font-weight: 600;
  }

  .colophon {
    padding-block: var(--space-7) var(--space-6);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
</style>
