---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.svelte';
import Uptime from '../components/Uptime.svelte';
import Experience from '../components/Experience.svelte';
import Skills from '../components/Skills.svelte';
import Clients from '../components/Clients.svelte';
import CopyEmail from '../components/CopyEmail.svelte';
import Shortcuts from '../components/Shortcuts.svelte';
import Checkout from '../components/Checkout.svelte';
import { profile } from '../data/profile';
import { roles, formatYM, toMonths } from '../data/experience';
import { blameAt, buildLog } from '../data/log';
import { buildStats } from '../data/skills';
import type { Commit } from '../scripts/checkout';

const current = roles.find((r) => r.end === null)!;
const first = roles.reduce((a, b) => (a.start < b.start ? a : b));
const builtAt = Date.now();
const year = new Date(builtAt).getFullYear();
const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '');
const log = buildLog();
const root = log.find((r) => r.kind === 'root')!.hash;

// about.md under `git blame`: each line on the role it dates from, numbered through the file. Like a blame
// hunk, the hash and date print only where the commit changes, and every paragraph opens a new hunk.
// `age` (0 oldest, 1 newest) tints the bar.
const oldest = toMonths(first.start);
const newest = new Date(builtAt).getFullYear() * 12 + new Date(builtAt).getMonth();
let lineNo = 0;
const about = profile.about.map((paragraph) => {
  let previous = '';
  return paragraph.map(({ text, since }) => {
    const row = blameAt(since, log);
    const at = toMonths(row.date);
    const same = row.hash === previous;
    previous = row.hash;
    return { text, n: ++lineNo, hash: row.hash, date: formatYM(row.date), at, same, age: (at - oldest) / (newest - oldest) };
  });
});
const commits: Commit[] = log
  .filter((r) => r.kind !== 'root')
  .map((r) => ({
    hash: r.hash,
    at: toMonths(r.date),
    lane: r.lane,
    subject: r.role?.company ?? `Merge branch '${r.merged}'`,
    role: r.role && {
      title: r.role.title,
      company: r.role.company,
      start: toMonths(r.role.start),
      end: r.role.end ? toMonths(r.role.end) : null,
    },
  }));
---

<Base
  title={`${profile.name} · ${profile.title}`}
  description={`${profile.name}, ${profile.lead.toLowerCase()} ${current.title} hos ${current.company}. Erfaring, GitHub og kontakt.`}
>
  <a class="skip" href="#erfaring">Spring til erfaring</a>

  <header class="hero">
    <div class="wrap">
      <div class="mark">
        <Wordmark client:load text={profile.name} />
      </div>

      <div class="intro">
        <div class="about" data-about>
          <p class="cmd">
            <span aria-hidden="true"><span class="prompt">$</span> <span data-blame-cmd>cat</span> about.md</span>
            <button type="button" class="blame" data-blame-toggle aria-pressed="false" hidden>git blame</button>
          </p>
          <p class="lead">{profile.lead}</p>
          {
            about.map((lines) => (
              <p class="bio">
                {lines.map((line, i) => (
                  <Fragment>
                    {i > 0 && ' '}
                    <span class="bl" data-blame-at={line.at} style={`--age: ${line.age.toFixed(2)}`}>
                      {!line.same && (
                        <Fragment>
                          <button
                            type="button"
                            class="gh"
                            data-checkout={line.hash}
                            aria-label={`git checkout ${line.hash}: se siden som i ${line.date}`}
                          >
                            {line.hash}
                          </button>
                          <span class="gd">{line.date}</span>
                        </Fragment>
                      )}
                      <span class="gn" aria-hidden="true">{line.n}</span>
                      <span class="txt">{line.text}</span>
                    </span>
                  </Fragment>
                ))}
              </p>
            ))
          }
        </div>

        <div class="side">
          <dl class="facts">
            <div><dt>rolle</dt><dd data-fact-role>{current.title}</dd></div>
            <div><dt>firma</dt><dd data-fact-company>{current.company}</dd></div>
            <div><dt>sted</dt><dd>{profile.city}</dd></div>
            <div><dt>siden</dt><dd>{formatYM(first.start)}</dd></div>
            <div>
              <dt>oppetid</dt>
              <dd><Uptime client:idle since={`${first.start}-01`} builtAt={builtAt} /></dd>
            </div>
          </dl>

          <ul class="links" aria-label="Kontakt">
            <li>
              <a href={`mailto:${profile.email}`}>{profile.email}</a>
              <kbd title="Tryk e">e</kbd>
            </li>
            <li>
              <a href={profile.github.url}>GitHub<span class="print-url">{bare(profile.github.url)}</span></a>
              <kbd title="Tryk g">g</kbd>
            </li>
            <li>
              <a href={profile.linkedin.url}>LinkedIn<span class="print-url">{bare(profile.linkedin.url)}</span></a>
              <kbd title="Tryk l">l</kbd>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </header>

  <main>
    <section id="kompetencer" class="skills wrap" aria-labelledby="kompetencer-h">
      <h2 id="kompetencer-h">Kompetencer</h2>
      <Skills client:visible stats={buildStats()} root={root} builtAt={builtAt} />
    </section>

    <section id="erfaring" class="experience wrap" aria-labelledby="erfaring-h">
      <h2 id="erfaring-h">Erfaring</h2>
      <Experience />
    </section>

    <section id="kunder" class="clients wrap" aria-labelledby="kunder-h">
      <h2 id="kunder-h">Kunder</h2>
      <Clients />
    </section>
  </main>

  <footer class="contact wrap" aria-labelledby="kontakt-h">
    <h2 id="kontakt-h">Kontakt</h2>
    <p class="cmd" aria-hidden="true"><span class="prompt">$</span> git remote -v</p>

    <ul class="remotes">
      <li>
        <span class="rname">email</span>
        <a class="rurl" href={`mailto:${profile.email}`}>{profile.email}</a>
        <span class="raction"><CopyEmail client:visible email={profile.email} /></span>
      </li>
      <li>
        <span class="rname">github</span>
        <a class="rurl" href={profile.github.url}>{bare(profile.github.url)}</a>
      </li>
      <li>
        <span class="rname">linkedin</span>
        <a class="rurl" href={profile.linkedin.url}>{bare(profile.linkedin.url)}</a>
      </li>
    </ul>

    <p class="colophon">
      <span>© {year} {profile.name}</span>
      <span class="keys">Genveje <kbd>e</kbd> <kbd>g</kbd> <kbd>l</kbd></span>
      <span class="keys">Tidsrejse <kbd>j</kbd> <kbd>k</kbd></span>
      <span class="keys">Blame <kbd>b</kbd></span>
    </p>
  </footer>

  <script>
    import { duration } from '../data/log';
    import type { YearMonth } from '../data/experience';

    const now = new Date();
    const ym = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}` as YearMonth;
    for (const el of document.querySelectorAll<HTMLElement>('[data-since]')) {
      el.textContent = duration(el.dataset.since as YearMonth, ym);
    }

    // `git blame about.md`: the toggle, and the command above the bio, exist only with JS. Without it: `cat`.
    const about = document.querySelector<HTMLElement>('[data-about]')!;
    const blame = about.querySelector<HTMLButtonElement>('[data-blame-toggle]')!;
    const blameCmd = about.querySelector('[data-blame-cmd]')!;
    blame.hidden = false;
    blame.addEventListener('click', () => {
      const on = about.toggleAttribute('data-blaming');
      blame.setAttribute('aria-pressed', String(on));
      blameCmd.textContent = on ? 'git blame' : 'cat';
    });

    // Long `Kunder:` trailers fold behind "+N flere"; without JS they print in full.
    for (const more of document.querySelectorAll<HTMLElement>('[data-fold] [data-more]')) {
      const rest = more.parentElement!.querySelector<HTMLElement>('[data-rest]')!;
      rest.hidden = true;
      more.hidden = false;
      more.querySelector('button')!.addEventListener('click', () => {
        rest.hidden = false;
        more.hidden = true;
        // The button is gone: hand focus to what it revealed.
        rest.tabIndex = -1;
        rest.focus();
      });
    }
  </script>

  <Shortcuts client:idle email={profile.email} github={profile.github.url} linkedin={profile.linkedin.url} />
  <Checkout client:idle commits={commits} builtAt={builtAt} />
</Base>

<style>
  /* ---- hero ---- */
  .hero {
    padding-block: clamp(2rem, 5vw, 3.5rem) 0;
  }

  .mark {
    container-type: inline-size;
  }

  .intro {
    display: grid;
    gap: var(--space-6);
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }

  .lead {
    color: var(--ink);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .bio {
    max-width: 40rem;
    margin-top: var(--space-4);
    font-size: var(--step-0);
  }

  /* ---- about.md: `cat` by default, `git blame` from the toggle (JS only) ---- */
  /* On the baseline of the first fact beside it: both columns open with a line of mono. */
  .about .cmd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin-block: 0 var(--space-3);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-variant-ligatures: none;
  }

  .about .prompt {
    color: var(--ink);
    font-weight: 700;
  }

  /* A toggle chip, like the log's ref pills; pressed, it takes the Ink fill. Low enough to stay in the line. */
  .blame {
    height: 1.25rem;
    padding: 0 0.6em;
    border: 1px solid var(--sage);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    font: 600 0.8rem / 1 var(--font-mono);
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-out),
      border-color 160ms var(--ease-out),
      color 160ms var(--ease-out);
  }

  .blame:hover {
    border-color: var(--ink);
  }

  .blame[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--mint);
  }

  /* Each line runs inline in its paragraph; the gutter only exists under blame. */
  .bl {
    transition: opacity 200ms var(--ease-out);
  }

  /* `git checkout`: lines written after the checked-out month fade, like the log's future rows. */
  .bl[data-future] {
    opacity: 0.22;
  }

  .gh,
  .gd,
  .gn {
    display: none;
  }

  /* Blame is a screen view: printed, about.md is just the bio, without its command. */
  @media print {
    .about .cmd {
      display: none;
    }
  }

  @media screen {
    [data-blaming] .bio {
      max-width: none;
      margin-top: var(--space-3);
    }

    [data-blaming] .bio + .bio {
      margin-top: var(--space-5);
    }

    /*
      One grid per line, so a faded line fades whole. Sized in the gutter's mono `ch`; the text sets its own
      font back. Phones: hash and date over the line, no numbers.
    */
    [data-blaming] .bl {
      position: relative;
      display: grid;
      grid-template-columns: 7ch auto minmax(0, 1fr);
      align-items: baseline;
      gap: 0 var(--space-3);
      padding: var(--space-1) 0 var(--space-1) var(--space-4);
      border-top: 1px solid var(--sage-soft);
      font-family: var(--font-mono);
      font-size: var(--step--1);
      font-variant-ligatures: none;
    }

    [data-blaming] .bio .bl:last-child {
      border-bottom: 1px solid var(--sage-soft);
    }

    /* Blame's age bar: Ink for the newest lines, Sage for the oldest. */
    [data-blaming] .bl::before {
      content: '';
      position: absolute;
      inset: 0 auto 0 0;
      width: 3px;
      background: color-mix(in srgb, var(--ink) calc(var(--age) * 100%), var(--sage-soft));
    }

    [data-blaming] .gh,
    [data-blaming] .gd {
      display: block;
      color: var(--ink-muted);
    }

    [data-blaming] .gh {
      grid-column: 1;
      justify-self: start;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      cursor: pointer;
      text-decoration: underline 2px var(--sage);
      text-underline-offset: 0.22em;
      transition: text-decoration-color 160ms var(--ease-out);
    }

    [data-blaming] .gh:hover {
      text-decoration-color: currentColor;
    }

    [data-blaming] .gd {
      grid-column: 2;
    }

    [data-blaming] .txt {
      grid-column: 1 / -1;
      color: var(--ink-body);
      font-family: var(--font-sans);
      font-size: var(--step-0);
    }
  }

  .facts {
    display: grid;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .facts div {
    display: grid;
    grid-template-columns: 7.5ch minmax(0, 1fr);
    gap: var(--space-3);
  }

  .facts dt {
    color: var(--ink-muted);
  }

  /* The title only wraps on the narrowest phones; it then breaks in even halves, not on its last word. */
  .facts dd {
    color: var(--ink);
    text-wrap: balance;
  }

  .links {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .links li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-2);
    border-top: 1px solid var(--sage-soft);
  }

  .links a {
    color: var(--ink);
    font-weight: 600;
    text-decoration-color: transparent;
  }

  .links a:hover {
    text-decoration-color: var(--ink);
  }

  .links kbd {
    font-size: 0.72rem;
  }

  /* ---- skills, experience & clients ---- */
  .skills,
  .experience,
  .clients {
    padding-top: clamp(3rem, 5.5vw, 4.25rem);
  }

  .skills h2,
  .experience h2,
  .clients h2,
  .contact h2 {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.25rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  /* ---- contact ---- */
  .contact {
    padding-block: clamp(4.5rem, 10vw, 8rem) var(--space-6);
  }

  .cmd {
    margin-block: var(--space-5) var(--space-3);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .prompt {
    color: var(--ink);
    font-weight: 700;
  }

  .remotes li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--sage-soft);
  }

  .remotes li:last-child {
    border-bottom: 1px solid var(--sage-soft);
  }

  .rname {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .rurl {
    justify-self: start;
    color: var(--ink);
    font-size: clamp(1.25rem, 0.85rem + 2.2vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
    text-decoration-color: transparent;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.16em;
  }

  .rurl:hover {
    text-decoration-color: var(--ink);
  }

  .raction {
    justify-self: start;
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-7);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .keys {
    display: none;
    align-items: center;
    gap: var(--space-1);
  }

  @media (hover: hover) and (pointer: fine) {
    .keys {
      display: inline-flex;
    }
  }

  @media (hover: none) {
    .links kbd {
      display: none;
    }
  }

  /*
    Two columns only once the side one can hold the longest fact on one line: the title in `rolle` is
    ~36ch of mono, so 23rem with the `dt` column. Below that, the facts get the full width.
  */
  @media (min-width: 60rem) {
    .intro {
      grid-template-columns: minmax(0, 7fr) minmax(23rem, 4fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  @media screen and (min-width: 48rem) {
    /* Wide enough for GitHub's layout: hash, date and line number to the left of the line. */
    [data-blaming] .bl {
      grid-template-columns: 7ch 8ch 2ch minmax(0, 1fr);
    }

    [data-blaming] .gn {
      display: block;
      grid-column: 3;
      color: var(--sage);
      text-align: right;
    }

    [data-blaming] .txt {
      grid-column: 4;
    }

    .remotes li {
      grid-template-columns: 9ch minmax(0, 1fr) auto;
      padding-block: var(--space-5);
    }

    .raction {
      justify-self: end;
    }
  }

  /* On paper a link is its address: GitHub and LinkedIn print where they go. */
  .print-url {
    display: none;
  }

  /*
    Print: a CV on A4. The name at a third of the width, bio beside the facts, contact as addresses. The footer
    repeats the hero's contact and is all buttons and shortcuts, so it stays on screen.
  */
  @media print {
    .hero {
      padding-top: 0;
    }

    .mark {
      width: 22rem;
    }

    .intro {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-6);
      margin-top: var(--space-5);
    }

    .lead {
      font-size: var(--step-2);
    }

    .bio {
      max-width: none;
      margin-top: var(--space-3);
    }

    .links {
      gap: 0;
      margin-top: var(--space-4);
    }

    .links li {
      padding-block: var(--space-1);
      border: 0;
    }

    .links a {
      font-weight: 500;
    }

    .links a[href^='http'] {
      font-size: 0;
    }

    .print-url {
      display: inline;
      font-size: var(--step-0);
    }

    .links kbd {
      display: none;
    }

    .skills,
    .experience,
    .clients {
      padding-top: var(--space-6);
    }

    .skills h2,
    .experience h2,
    .clients h2 {
      font-size: 16pt;
    }

    .contact {
      display: none;
    }
  }
</style>
